# Wajib -------------------------------------------------------------
# String acak minimal 32 karakter. Buat dengan: openssl rand -hex 32
PAYLOAD_SECRET=ganti-dengan-string-acak-panjang
# Database SQLite (file lokal) atau libSQL/Turso (libsql://...)
DATABASE_URL=file:./data/klinik.db
# Folder foto unggahan (default ./media). Di Hostinger isi dengan path di luar folder aplikasi.
MEDIA_DIR=
# Token Turso bila memakai libsql:// (kosongkan untuk file lokal)
DATABASE_AUTH_TOKEN=
# URL publik situs, dipakai untuk sitemap, Open Graph, dan tautan kanonik
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domain tanpa https:// untuk Caddy (HTTPS otomatis) di docker-compose, contoh: bintangusadabakti.com
SITE_DOMAIN=

# Opsional ----------------------------------------------------------
# Image jadi dari GitHub Actions (tanpa build di VPS), contoh: ghcr.io/sashacvi/klinik-mst-web:latest
WEB_IMAGE=
# Batas memori & CPU container website (default 1g dan 1.5)
WEB_MEM_LIMIT=
WEB_CPUS=
# Port lokal website bila memakai Nginx yang sudah ada (deploy/compose.tanpa-caddy.yml), default 3010
WEB_HOST_PORT=
# Isi data awal otomatis saat database kosong (default aktif). AUTO_SEED=0 untuk mematikan.
AUTO_SEED=
# Google Maps Embed API (gratis, tanpa batas kuota). Bila diisi, peta memakai
# Google Maps; bila kosong, peta memakai OpenStreetMap + koordinat di Pengaturan Situs.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Sinkronisasi ulasan Google (Places API New). Maksimal 5 ulasan per permintaan.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
